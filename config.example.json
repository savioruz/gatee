{
  "listen": "0.0.0.0:7890",
  "password": "",
  "ca_cert": "ca.pem",
  "ca_key": "ca-key.pem",
  "upstreams": [
    {
      "name": "direct",
      "kind": "direct"
    },
    {
      "name": "vercel-relay",
      "kind": "vercel",
      "url": "https://gatee-worker.vercel.app/api/relay"
    },
    {
      "name": "socks5-proxy",
      "kind": "socks5",
      "url": "socks5://127.0.0.1:1080"
    }
  ],
  "pools": {
    "default": {
      "strategy": "failover",
      "cooldown_secs": 30,
      "members": ["direct"],
      "mitm_hosts": []
    },
    "stealth": {
      "strategy": "round_robin",
      "cooldown_secs": 30,
      "members": ["vercel-relay", "socks5-proxy"],
      "mitm_hosts": ["*.anthropic.com", "api.openai.com"]
    }
  }
}
